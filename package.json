{
  "name": "neva",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "art:generate": "node tools/blender/cli.mjs generate",
    "art:generate:strict": "node tools/blender/cli.mjs generate --strict",
    "art:validate": "node tools/blender/cli.mjs validate",
    "art:determinism": "node tools/blender/cli.mjs determinism",
    "art:preview": "node tools/blender/cli.mjs preview",
    "art:test-builders": "node tools/blender/cli.mjs test-builders",
    "art:benchmark": "playwright test tests/e2e/art-pipeline.spec.ts --project=chromium"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.174.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "@playwright/test": "^1.50.1",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.174.0",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "@vitejs/plugin-react": "^4.3.4",
    "ajv": "^8.20.0",
    "eslint": "^9.20.1",
    "gltf-validator": "^2.0.0-dev.3.10",
    "meshoptimizer": "^1.2.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
