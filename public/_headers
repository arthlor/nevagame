# HTML shell must never be cached by browsers or edge proxies
/
  Cache-Control: no-cache, no-store, must-revalidate
/index.html
  Cache-Control: no-cache, no-store, must-revalidate

# Fingerprinted JS and CSS bundles produced by Vite (filename changes per build)
/assets/*.js
  Cache-Control: public, max-age=31536000, immutable
/assets/*.css
  Cache-Control: public, max-age=31536000, immutable

# Model URLs include a build-time content fingerprint in their query string
/assets/models/*
  Cache-Control: public, max-age=31536000, immutable
