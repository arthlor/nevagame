{
  "name": "neva",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "npm run assets:sync",
    "dev": "vite",
    "prebuild": "npm run assets:sync",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "pretypecheck": "npm run assets:sync",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "pretest": "npm run assets:sync",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "world:acceptance": "node tools/world/acceptance.mjs",
    "art:codegen": "node tools/art/codegen.mjs",
    "art:codegen:check": "node tools/art/codegen.mjs --check",
    "art:brief": "node tools/blender/cli.mjs brief",
    "art:generate": "node tools/blender/cli.mjs generate",
    "art:generate:strict": "node tools/blender/cli.mjs generate --strict",
    "art:validate": "node tools/blender/cli.mjs validate",
    "art:sync": "node tools/blender/cli.mjs sync",
    "art:determinism": "node tools/blender/cli.mjs determinism",
    "art:test-builders": "node tools/blender/cli.mjs test-builders",
    "art:benchmark": "playwright test tests/e2e/art-pipeline.spec.ts --project=chromium",
    "art:benchmark:extended": "NEVA_ART_EXTENDED=1 playwright test tests/e2e/art-pipeline.spec.ts --project=chromium",
    "audio:ingest": "node tools/audio/ingest-freesound.mjs",
    "audio:normalize": "node tools/audio/normalizeBus.mjs",
    "audio:normalize:check": "node tools/audio/normalizeBus.mjs --check",
    "visual:update": "playwright test --config=playwright.visual.config.ts --update-snapshots",
    "visual:test": "playwright test --config=playwright.visual.config.ts",
    "tools": "node tools/cli.mjs",
    "tools:ci": "node tools/cli.mjs ci",
    "assets:sync": "npm run art:codegen && npm run ui:codegen && npm run ui:publish && npm run ui:atlas",
    "ui:slice": "node tools/ui/slice-sheet.mjs",
    "ui:publish": "node tools/ui/publish-atlas.mjs",
    "ui:publish:check": "node tools/ui/publish-atlas.mjs --check",
    "ui:codegen": "node tools/ui/codegen.mjs",
    "ui:codegen:check": "node tools/ui/codegen.mjs --check",
    "ui:atlas": "node tools/ui/extrudeAndPack.mjs",
    "ui:pack": "node tools/ui/extrudeAndPack.mjs",
    "ui:pack:check": "node tools/ui/extrudeAndPack.mjs --check",
    "content:validate": "vite-node tools/content/validate.ts",
    "test:budget": "playwright test --config=playwright.budget.config.ts"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.174.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.4",
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "@playwright/test": "^1.50.1",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.174.0",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "@vitejs/plugin-react": "^4.3.4",
    "ajv": "^8.20.0",
    "eslint": "^9.20.1",
    "gltf-validator": "^2.0.0-dev.3.10",
    "maxrects-packer": "^2.7.3",
    "meshoptimizer": "^1.2.0",
    "recast": "^0.24.0",
    "sharp": "^0.35.4",
    "three-mesh-bvh": "^0.9.14",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
