# HTML shell and manifest must never be cached by browsers or edge proxies
/
  Cache-Control: no-cache, no-store, must-revalidate
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
/manifest.webmanifest
  Cache-Control: no-cache, no-store, must-revalidate
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# Fingerprinted JS and CSS bundles produced by Vite (filename changes per build)
/assets/*.js
  Cache-Control: public, max-age=31536000, immutable
/assets/*.css
  Cache-Control: public, max-age=31536000, immutable

# Model URLs include a build-time content fingerprint in their query string
/assets/models/*
  Cache-Control: public, max-age=31536000, immutable

# App icons
/assets/ui/icons/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Packed UI atlas pages carry a content hash in the filename, so they are safe
# to cache immutably for a year. Rebuilding with new art writes a new name.
/assets/ui/atlas/ui-atlas_*.webp
  Cache-Control: public, max-age=31536000, immutable

# Stable-name published UI sprites (frames, panel textures, icons). These
# revalidate in the background instead of blocking a repeat visit.
/assets/ui/atlas/*.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Entry cinematic and poster (stable filenames, so they stay revalidating)
/assets/video/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
